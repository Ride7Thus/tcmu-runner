    {
      "type": "timeseries",
      "title": "Timeouts and lost connections",
      "id": 18,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance, device) (increase(tcmu_cmd_timed_out_total{instance=~\"$instance\",device=~\"$device\"}[$__rate_interval]))",
          "legendFormat": "timeout {{instance}} {{device}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
